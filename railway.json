{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter codefox-backend build && npm i -g --prefix /app/.pnpm-bin pnpm@9"
  },
  "deploy": {
    "startCommand": "node --experimental-specifier-resolution=node backend/dist/main",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
