# ─── Server ───────────────────────────────────────────────────────────────
PORT=8080

# Anything other than "production" behaves as development.
NODE_ENV=development

# ─── Auth (required) ──────────────────────────────────────────────────────
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH="your_jwt_refresh_secret_here"
SALT_ROUNDS=10

# ─── The agent (required — this is the product) ───────────────────────────
# CodeFox drives the real Claude Code CLI through the AI SDK harness, so it
# needs an *Anthropic-compatible* endpoint. An OpenAI-compatible one
# (OpenRouter, ollama, LM Studio) cannot drive it — see LLM_* below for what
# those are used for.
#
# Pick one:
#   1. A cloud key
ANTHROPIC_API_KEY="sk-ant-..."
#   2. Or a local proxy in front of an already-signed-in Claude CLI
# ANTHROPIC_BASE_URL="http://127.0.0.1:8317"
# ANTHROPIC_AUTH_TOKEN="whatever_the_proxy_expects"
#
# The harness installs the CLI itself into /tmp/harness/claude-code on first
# use, so the host needs `pnpm` on PATH and network access to the npm
# registry. On a container with an ephemeral /tmp this happens every restart.

# ─── Sandbox: where the agent's files live and its shell runs ─────────────
# host   (default) — the backend's own disk. Zero setup, and the preview is a
#          local dev server. NOT isolation: the agent runs bash with this
#          process's privileges, so only use it where every user is trusted.
# vercel — a real remote microVM per session, seeded straight from
#          TEMPLATE_REPO by git clone. Required for anything multi-tenant.
# SANDBOX_PROVIDER=vercel
# VERCEL_PROJECT_ID="prj_..."
# VERCEL_TEAM_ID="team_..."
#
# Credentials: the SDK tries an OIDC token first and only then an explicit
# token — a logged-in Vercel CLI is NOT enough on its own. Either
#   local:      vercel link && vercel env pull   (writes VERCEL_OIDC_TOKEN
#               into .env.local; it is short-lived, so re-pull as needed)
#   deployed:   VERCEL_TOKEN="..."               (long-lived access token)
# VERCEL_TOKEN="..."
#
# SANDBOX_TIMEOUT_MS=1800000   # sandbox auto-terminates after this
# SANDBOX_VCPUS=2              # 2048 MB memory per vCPU

# ─── Prompt helpers (optional) ────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Used for the "Enhance" button, project
# auto-naming, and chats that have no project. NOT used for the agent.
# Defaults to OpenRouter when unset.
# LLM_BASE_URL="https://openrouter.ai/api/v1"
LLM_API_KEY="your_openrouter_api_key_here"
# Comma separated; the first is the default unless LLM_DEFAULT_MODEL says so.
# Ids must match what the endpoint serves.
LLM_MODELS="anthropic/claude-sonnet-4.5,openai/gpt-4o-mini"
# LLM_DEFAULT_MODEL="anthropic/claude-sonnet-4.5"

# ─── Database ─────────────────────────────────────────────────────────────
# Unset or non-postgres -> SQLite under .codefox/data, zero setup.
# DATABASE_URL="postgresql://username:password@localhost:5432/codefox"
#
# This repo carries no migrations, so a production database starts empty and
# every query fails. Set this to true for the first production boot to create
# the schema, then remove it — synchronize will drop a column to match an
# entity.
# DB_SYNCHRONIZE=true

# ─── Object storage (optional) ────────────────────────────────────────────
# Without these, uploads are written to .codefox/media on local disk.
# S3_ACCESS_KEY_ID="your_s3_access_key_id"
# S3_SECRET_ACCESS_KEY="your_s3_secret_access_key"
# S3_REGION="auto"
# S3_BUCKET_NAME="your_bucket_name"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_ACCOUNT_ID="your_cloudflare_account_id"
# S3_PUBLIC_URL="https://pub-xxx.r2.dev"

# ─── Email (optional) ─────────────────────────────────────────────────────
# With this false, registration confirms accounts immediately.
MAIL_ENABLED=false
# MAIL_HOST=smtp.example.com
# MAIL_USER=user@example.com
# MAIL_PASSWORD=topsecret
# MAIL_FROM=noreply@example.com
# MAIL_PORT=587
# MAIL_DOMAIN=your_net

# ─── Google OAuth (optional) ──────────────────────────────────────────────
# The sign-in and sign-up modals hide the Google button unless the frontend
# also sets NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED.
# GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
# GOOGLE_SECRET=Your_SECRET
# GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# ─── GitHub ───────────────────────────────────────────────────────────────
# Currently disabled: GitHubModule is commented out in app.module.ts, so none
# of these are read. Left here for when it comes back.
