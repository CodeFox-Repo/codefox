# Dependencies
node_modules/
*/**/node_modules/

# Turbo
.turbo/
*/**/.turbo/

# Build outputs
dist/
*/**/dist/

# Models
# Model weights live under .codefox/models, which the `.codefox` rule above
# already covers. A bare `models/` also matched backend/src/common/models —
# git kept serving those files because they were tracked before the rule
# existed, but anything that filters the filesystem by .gitignore (a
# `railway up` upload, a Docker context) silently dropped the directory and
# the build failed on 41 cascading "cannot find module" errors.

*/**/database.sqlite
./backend/src/database.sqlite
.codefox

.env
.gstack/

# Vercel CLI link + the OIDC token `vercel env pull` writes. Both are
# credentials or account-specific and must never be committed.
.vercel
.env.local
.env*.local
.env*

# Local agent tooling config
.claude/

# QA screenshots dropped at the repo root during agent sessions
/*.png

# Visual QA screenshots and walk scripts (not committed).
qa/

# Ad-hoc probe scripts written during debugging sessions
*.tmp.mjs

# Agent runtime state (nested worktrees) and local UI screenshots
.kobe/
/frontend/*.png
